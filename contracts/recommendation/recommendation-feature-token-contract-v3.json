    "canonicalTokenIdentity": "EXACT_AFTER_RESOLUTION",
    "vectorAggregation": "CONTRACT_SELECTED_AFTER_VALIDATION"
  },
  "namespaces": [
    {
      "id": "interest",
      "tokenPattern": "^interest:[a-z0-9][a-z0-9./-]*$",
      "valueSource": { "kind": "taxonomy", "conceptType": "INTEREST" }

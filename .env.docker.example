# Docker Compose environment template.
# Copy to .env.docker at the repository root and fill in real values.
# Do not commit .env.docker (it contains secrets).

POSTGRES_USER=impactloop
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=impactloop

API_PORT=4000

# Browser origins allowed by CORS (comma-separated HTTPS URLs in production).
CORS_ORIGIN=https://app.example.com
APP_PUBLIC_BASE_URL=https://app.example.com

# Minimum 24 characters each; use cryptographically random values.
JWT_ACCESS_SECRET=change-me-access-secret-min-24-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-24-chars
HANDOVER_CODE_SECRET=change-me-handover-code-secret-min-24

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM=ImpactLoop <no-reply@example.com>

PAYMENT_PROVIDER=disabled
TRUST_PROXY=1
LOG_LEVEL=info

RECOMMENDATION_SCORER_VERSION=legacy-v1
RECOMMENDATION_ML_SHADOW_ENABLED=false
RECOMMENDATION_OUTBOX_WORKER_ENABLED=true
RECOMMENDATION_OUTBOX_WORKER_REQUIRED=true

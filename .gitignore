# Secrets
.env
.env.*
!.env.docker.example
*.pem
*.key

# Dependencies
node_modules/
.pnpm-store/
.yarn/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Builds
dist/
build/
coverage/
apps/frontend/build/
apps/backend/dist/
apps/frontend/coverage/

# Local Admin export verification artifacts
apps/backend/tmp-exports/
apps/backend/tmp/

# Generated / machine-written
apps/backend/src/generated/
apps/backend/generated/
apps/backend/prisma/generated/
apps/frontend/lib/generated/
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.mocks.dart

# Offline ML compatibility environments and generated artifacts
ml/recommendation/.venv/
ml/recommendation/.venv311/
ml/recommendation/python311/
ml/recommendation/conda-env/
ml/recommendation/conda-env-repro/
ml/recommendation/miniconda/
ml/recommendation/generated/
ml/recommendation/.pytest_cache/
ml/recommendation/**/__pycache__/

# Usually not useful for agent context unless explicitly needed
apps/frontend/pubspec.lock
apps/backend/package-lock.json
apps/backend/pnpm-lock.yaml

# Heavy files
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.zip

!apps/frontend/assets/**
# Keep community demo material originals trackable in-repo.
!apps/backend/prisma/demo-data/materials/source-images/**
!apps/backend/prisma/demo-data/materials/source-images/**/*.png
!apps/backend/prisma/demo-data/materials/source-images/**/*.jpg
!apps/backend/prisma/demo-data/materials/source-images/**/*.jpeg
!apps/backend/prisma/demo-data/materials/source-images/**/*.webp
# Keep community demo project covers trackable in-repo (PD-03 + localized legacy).
!apps/backend/prisma/demo-data/projects/source-images/**
!apps/backend/prisma/demo-data/projects/source-images/**/*.png
!apps/backend/prisma/demo-data/projects/source-images/**/*.jpg
!apps/backend/prisma/demo-data/projects/source-images/**/*.jpeg
!apps/backend/prisma/demo-data/projects/source-images/**/*.webp
# Keep curated demo visual assets (people avatars/covers) trackable in-repo.
!apps/backend/prisma/demo-data/visual-assets/**
!apps/backend/prisma/demo-data/visual-assets/**/*.png

# Local recovery / forensic audit artifacts (not demo assets)
apps/backend/tmp-recovery-audit/

# Logs
*.log


+  const hasArgument = (argument: string) => normalizedArgs.includes(argument);
+  const takeForwardedValue = (): string | undefined => {
+    const index = normalizedArgs.findIndex(
+      (entry, entryIndex) => entryIndex > 0 && !entry.startsWith('--'),
+    );

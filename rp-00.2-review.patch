+const verifyAcceptedFixture = (
+  accepted: BaselineFixture,
+  generated: BaselineFixture,
+): void => {
+  if (
+    accepted.identityContract.databaseSnapshotFingerprint !==
+    generated.identityContract.databaseSnapshotFingerprint

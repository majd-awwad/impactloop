# Loaded after apps/backend/.env (see src/config/env.ts)
# Copy to config/invitations.env and fill in for local SMTP testing.

APP_PUBLIC_BASE_URL=http://localhost:YOUR_FLUTTER_WEB_PORT
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:YOUR_FLUTTER_WEB_PORT

# Gmail SMTP example:
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ImpactLoop <your@gmail.com>"

# Copy to apps/backend/.env and fill in real values.
# Do not commit real SMTP credentials.

DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/impactloop?schema=public"

# Observability
SERVICE_NAME=impactloop-api
LOG_LEVEL=debug
LOG_PRETTY=true
# Local development only: set to true to print mock password-reset/invitation links in logs.
MOCK_EMAIL_LOG_LINKS=false

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:63052

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

EMAIL_PROVIDER=mock
APP_PUBLIC_BASE_URL=http://localhost:YOUR_FLUTTER_WEB_PORT

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ImpactLoop <no-reply@your-domain.com>"

# General Learning / ImpactLoop Assistant chat (separate from price AI)
# In development, apps/backend/.env overrides inherited Windows/IDE env values.
AI_CHAT_PROVIDER=mock
# AI_CHAT_PROVIDER=gemini
# GEMINI_API_KEY=your_key_from_https://aistudio.google.com/apikey
# AI_CHAT_MODEL=gemini-3.1-flash-lite
# Optional local-only escape hatch. Default is false.
# AI_CHAT_DEV_MOCK_FALLBACK_ENABLED=false

# Controlled external domain knowledge search (disabled by default)
AI_WEB_SEARCH_ENABLED=false
# mock | gemini_grounding (requires GEMINI_API_KEY; separate from AI_CHAT_MODEL)
AI_WEB_SEARCH_PROVIDER=mock
# AI_WEB_SEARCH_MODEL=gemini-2.0-flash
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_TIMEOUT_MS=8000

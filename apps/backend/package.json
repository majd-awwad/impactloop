{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "seed:project-budget-demo": "tsx prisma/seed.ts --project-budget-demo",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/modules/**/*.test.ts",
    "typecheck:recommendations-baseline": "tsc --ignoreConfig --noEmit --target ES2022 --module Node16 --moduleResolution Node16 --strict --esModuleInterop --skipLibCheck src/types/express.d.ts scripts/benchmark-learner-home.ts scripts/benchmark-learner-home.test.ts",
    "recommendations:baseline": "tsx scripts/benchmark-learner-home.ts",
    "typecheck:ranking-delta-evaluator": "tsc --ignoreConfig --noEmit --target ES2022 --module Node16 --moduleResolution Node16 --strict --esModuleInterop --skipLibCheck src/types/express.d.ts scripts/evaluate-ranking-delta.ts scripts/evaluate-ranking-delta.test.ts scripts/evaluate-ranking-delta.orchestration.test.ts",
    "typecheck:recommendations:ci": "npm run typecheck:recommendations-baseline && npm run typecheck:ranking-delta-evaluator",
    "test:recommendations:ci:pure": "node scripts/ci/run-recommendation-ci-tests.mjs pure",
    "test:recommendations:ci:db": "node scripts/ci/recommendation-ci-guard.mjs database && node scripts/ci/run-recommendation-ci-tests.mjs db",
    "guard:recommendations:ci:database": "node scripts/ci/recommendation-ci-guard.mjs database",
    "evaluate:ranking-delta": "tsx scripts/evaluate-ranking-delta.ts",
    "evaluate:4j-a": "tsx scripts/evaluate-slice-4j-a.ts",
    "recommendations:demo:preflight": "tsx scripts/recommendations-demo-preflight.ts",
    "recommendations:ml:snapshot:local": "tsx scripts/export-local-ml-training-snapshot.ts",
    "recommendations:ml:train:local": "tsx scripts/train-local-lightfm.ts train",
    "recommendations:ml:validate:local": "tsx scripts/train-local-lightfm.ts validate-artifact",
    "recommendations:ml:smoke:local": "tsx scripts/recommendations-ml-smoke-local.ts",
    "test:recommendations:ml:local": "node --import tsx --test scripts/train-local-lightfm.test.ts",
    "typecheck:recommendations:ml:local": "tsc --ignoreConfig --noEmit --target ES2022 --module Node16 --moduleResolution Node16 --strict --esModuleInterop --skipLibCheck src/types/express.d.ts scripts/train-local-lightfm.ts scripts/train-local-lightfm.test.ts",
    "validate:production-config": "tsx scripts/validate-production-config.ts",
    "test:validate:production-config": "node --import tsx --test scripts/validate-production-config.test.ts",
    "taxonomy:category-ownership": "tsx scripts/category-taxonomy-ownership.ts",
    "taxonomy:material-audit": "tsx scripts/material-taxonomy-audit.ts",
    "clean-dev-notifications": "tsx ../../scripts/clean-dev-notifications.ts",
    "clean-driver-notifications": "tsx ../../scripts/clean-driver-notifications.ts",
    "backfill-driver-new-job-notifications": "tsx ../../scripts/backfill-driver-new-job-notifications.ts",
    "verify-driver-notifications": "tsx ../../scripts/verify-driver-notifications.ts",
    "verify:driver-profile-availability-migration": "tsx scripts/verify-driver-profile-availability-migration.ts",
    "verify:driver-available-jobs-waiting-index": "tsx scripts/verify-driver-available-jobs-waiting-index.ts",
    "bench:driver-query-scale": "tsx scripts/bench-driver-query-scale.ts",
    "backfill:material-thumbnails": "tsx scripts/backfill-material-thumbnails.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.9.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "openai": "^6.46.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}

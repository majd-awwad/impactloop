# Copy to apps/backend/.env and fill in real values.
# Do not commit real secrets (API keys, SMTP passwords, JWT secrets).
#
# Canonical template: apps/backend/.env.example
# Alias (must stay byte-identical): apps/backend/env.example
#
# Whole-app production preflight:
#   npm run validate:production-config -w apps/backend
#   npm run validate:production-config -w apps/backend -- --json
# Recommendation Release A gate (RP-00.4):
#   npm run validate:recommendation-release-config -w apps/backend
#   npm run validate:recommendation-release-config -w apps/backend -- --json
# Requires explicit NODE_ENV=production, DATABASE_URL, legacy-v1 champion,
# ML serving disabled, and outbox worker enabled when required.
# Exit codes:
#   0 — configuration is valid for the selected validator.
#   1 — configuration or database contract is unsafe/invalid.
#   2 — CLI invocation error or internal validator execution failure.

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/impactloop?schema=public"
# Automated backend tests ONLY (npm test). Must NOT be the development database name.
# Create/migrate with: npm run test:db:migrate -w apps/backend
TEST_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/impactloop_test?schema=public"

# Reverse-proxy trust for req.ip / rate limiting (default: false).
# Use 1 when one trusted reverse proxy (e.g. nginx) sits in front of the API.
# TRUST_PROXY=1
# In-memory rate limiter bounds (defaults shown).
# RATE_LIMIT_MAX_ENTRIES=10000
# RATE_LIMIT_SWEEP_INTERVAL_MS=60000

# Observability
SERVICE_NAME=impactloop-api
LOG_LEVEL=debug
LOG_PRETTY=true
# Local development only: set to true to print mock password-reset/invitation links in logs.
MOCK_EMAIL_LOG_LINKS=false

# Comma-separated browser origins allowed by CORS (Flutter web port included).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:63052

# ---------------------------------------------------------------------------
# Upload storage (local filesystem)
# ---------------------------------------------------------------------------
# Production: mount a persistent volume and set UPLOAD_ROOT_DIR to that path.
# Docker Compose sets UPLOAD_ROOT_DIR=/data/uploads automatically.
# Local development: leave unset (defaults to apps/backend/uploads/).
# Object storage (S3/MinIO) is not implemented; see docs/deployment.md.
# UPLOAD_ROOT_DIR=/data/uploads

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Dedicated secret for deterministic handover confirmation codes (required in production).
HANDOVER_CODE_SECRET=change-me-handover-code-secret
# Optional JWT / auth token lifetimes (defaults shown)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# PASSWORD_RESET_EXPIRES_IN=30m
# INVITATION_EXPIRES_IN=7d

EMAIL_PROVIDER=mock
# Must match your Flutter web URL for invitation / reset links.
APP_PUBLIC_BASE_URL=http://localhost:YOUR_FLUTTER_WEB_PORT

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ImpactLoop <no-reply@your-domain.com>"

# ---------------------------------------------------------------------------
# Price suggestion AI (materials review) — separate from learner chat
# Allowed: gemini | mock | disabled
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_key_from_https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# General Learning / ImpactLoop Assistant chat (separate from price AI)
# Allowed: openai | gemini | mock | disabled
# In development, apps/backend/.env overrides inherited Windows/IDE env values.
# ---------------------------------------------------------------------------
AI_CHAT_PROVIDER=mock
# AI_CHAT_PROVIDER=gemini
# AI_CHAT_PROVIDER=openai
# AI_CHAT_MODEL=gemini-2.0-flash
# OpenRouter free models (OpenAI-compatible):
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL is used ONLY when AI_CHAT_MODEL is unset (backward-compatible).
# Prefer AI_CHAT_MODEL as the canonical chat model for every provider.
# OPENAI_MODEL=openrouter/free
# AI_CHAT_MODEL=openrouter/free
# OPENAI_JSON_MODE=false
# Optional local-only escape hatch. Default is false.
# AI_CHAT_DEV_MOCK_FALLBACK_ENABLED=false

# Optional chat tuning (defaults match env.ts)
# AI_CHAT_TIMEOUT_MS=30000
# AI_CHAT_MAX_OUTPUT_TOKENS=1024
# AI_CHAT_MAX_MESSAGE_LENGTH=4000
# AI_CHAT_MAX_HISTORY_MESSAGES=20
# AI_CHAT_RATE_LIMIT_PER_USER=30
# AI_CHAT_RATE_LIMIT_WINDOW_MS=3600000
# AI_CHAT_MAX_CONVERSATIONS_PER_HOUR=20
# AI_CHAT_PROCESSING_STALE_MS=120000
# AI_CHAT_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Project Learning Pack generation (Learning Hub)
# ---------------------------------------------------------------------------
# Production: leave unset (or gemini) and use a valid GEMINI_API_KEY.
# Local E2E without Gemini: local_deterministic (ignored in NODE_ENV=production).
# PROJECT_LEARNING_GENERATOR_MODE=local_deterministic
# PROJECT_LEARNING_GENERATOR_MODE=gemini

# ---------------------------------------------------------------------------
# Admin data export (CSV / XLSX / Reservations PDF)
# ---------------------------------------------------------------------------
# Max rows for CSV and XLSX downloads (default 10000).
# ADMIN_EXPORT_MAX_ROWS=10000
# Cursor/keyset chunk size for export retrieval (default 500).
# ADMIN_EXPORT_CHUNK_SIZE=500
# Max detailed rows for PDF administrative reports (default 500; MVP tunable).
# ADMIN_EXPORT_PDF_MAX_ROWS=500

# Controlled external domain knowledge search (disabled by default)
AI_WEB_SEARCH_ENABLED=false
# mock | gemini_grounding (requires GEMINI_API_KEY; separate from AI_CHAT_MODEL)
AI_WEB_SEARCH_PROVIDER=mock
# AI_WEB_SEARCH_MODEL=gemini-2.0-flash
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_TIMEOUT_MS=8000

# OpenStreetMap Nominatim reverse geocoding (supplier profile)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ImpactLoop/1.0 (supplier profile reverse geocoding)

# ---------------------------------------------------------------------------
# Recommendations (Release A defaults: deterministic champion, ML off)
# ---------------------------------------------------------------------------
# Allowed runtime values: legacy-v1 | normalized-interests-v2 | canonical-taxonomy-v3
# Production validator accepts only legacy-v1 for Release A.
RECOMMENDATION_SCORER_VERSION=legacy-v1

# Optional explicit ML runtime mode: DETERMINISTIC | SHADOW | ML_LOCAL
# If unset, SHADOW when RECOMMENDATION_ML_SHADOW_ENABLED=true, else DETERMINISTIC.
# ML_LOCAL is development/test only.
# RECOMMENDATION_ML_RUNTIME_MODE=DETERMINISTIC

# ML shadow / serving (Release A: keep serving disabled; shadow optional when serving is off)
RECOMMENDATION_ML_SHADOW_ENABLED=false
RECOMMENDATION_ML_MATERIAL_SERVING_ENABLED=false
RECOMMENDATION_ML_PROJECT_SERVING_ENABLED=false
RECOMMENDATION_ML_MATERIAL_ARTIFACT_PATH=
RECOMMENDATION_ML_PROJECT_ARTIFACT_PATH=

# Recommendation outbox worker (RP-04.1)
# required defaults to true when NODE_ENV=production; enabled must be true when required.
RECOMMENDATION_OUTBOX_WORKER_ENABLED=false
# Leave unset in development (defaults to false). Set true/false explicitly in production.
# RECOMMENDATION_OUTBOX_WORKER_REQUIRED=
RECOMMENDATION_OUTBOX_POLL_INTERVAL_MS=2000
RECOMMENDATION_OUTBOX_BATCH_SIZE=10
RECOMMENDATION_OUTBOX_MAX_ATTEMPTS=5
RECOMMENDATION_OUTBOX_LEASE_MS=30000

# ---------------------------------------------------------------------------
# Lifecycle workers (background persistence sweeps)
# GET/list paths derive effective status without mutating; these workers persist
# expiries, escalations, match availability, and build-sync repairs.
# Deadlines themselves are unchanged (hours/days); intervals only control how
# often the sweeper looks for due work.
# ---------------------------------------------------------------------------
# Reservation expiry/escalation sweep (default 5 minutes)
# RESERVATION_LIFECYCLE_INTERVAL_MS=300000
# RESERVATION_LIFECYCLE_BATCH_SIZE=100
# Driver pickup/drop-off reminder sync (default 1 minute; lookahead is 15 minutes)
# RESERVATION_LIFECYCLE_REMINDER_INTERVAL_MS=60000
# Material-request OPEN expiry / SUGGESTED match / FULFILLED build-sync sweep
# (default 5 minutes)
# MATERIAL_REQUEST_LIFECYCLE_INTERVAL_MS=300000
# MATERIAL_REQUEST_LIFECYCLE_BATCH_SIZE=100

# Handover confirmation codes (HANDOVER_CODE_SECRET above; required in production)
# Handover confirmation code brute-force protection
# HANDOVER_CODE_MAX_ATTEMPTS=5
# HANDOVER_CODE_LOCKOUT_MS=900000

# ---------------------------------------------------------------------------
# Payments (PAY-01 mock provider / PAY-01B runtime gating)
# Real Bank of Palestine / PalPay / Jawwal / Stripe credentials are not used.
#
# Development / test: PAYMENT_PROVIDER=mock with LOCAL mode is allowed.
# Production: set PAYMENT_PROVIDER=disabled (Mock is rejected at startup).
# SANDBOX mode requires non-placeholder distinct secrets (min 24 chars).
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_MODE=LOCAL
PAYMENT_MOCK_WEBHOOK_SECRET=dev-payment-mock-webhook-secret-change-me
PAYMENT_MOCK_CHECKOUT_TOKEN_SECRET=dev-payment-mock-checkout-token-secret-change-me
# PAYMENT_MOCK_WEBHOOK_REPLAY_WINDOW_MS=300000
# PAYMENT_MOCK_CHECKOUT_TTL_MS=1800000
# Production example (Mock prohibited):
# PAYMENT_PROVIDER=disabled
# (omit PAYMENT_PROVIDER_MODE and mock secrets)
#
# Local demo: keep PAYMENT_PROVIDER=mock. Automated tests default enforcement
# OFF unless a suite calls setElectronicPaymentEnforcementForTests(true).
# See docs/features/payments.md.

# ---------------------------------------------------------------------------
# Project Help Sessions — Zoom integration (Server-to-Server OAuth)
# Allowed: fake | real | disabled
# fake/disabled require no credentials; real requires all fields below.
# ---------------------------------------------------------------------------
ZOOM_INTEGRATION_MODE=fake
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_API_BASE_URL=https://api.zoom.us/v2
ZOOM_TOKEN_URL=https://zoom.us/oauth/token

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
DATABASE_URL=postgresql://user:password@localhost:5432/impactloop

# AI-assisted price suggestions for review requests (backend only)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenStreetMap Nominatim reverse geocoding (supplier profile)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ImpactLoop/1.0 (supplier profile reverse geocoding)

# AI_PROVIDER=mock
# AI_PROVIDER=disabled

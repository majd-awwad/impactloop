generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  SUPPLIER
  DRIVER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PHONE_OTP
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum RoleInvitationTargetRole {
  DRIVER
  MODERATOR
  ADMIN
}

enum RoleInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MaterialCondition {
  NEW
  LIKE_NEW
  GOOD
  USED
  NEEDS_REPAIR
}

enum MaterialSourceType {
  STUDENT_LEFTOVER
  WORKSHOP_SURPLUS
  FACTORY_SURPLUS
  EDUCATIONAL_INSTITUTION
}

enum MaterialStatus {
  AVAILABLE
  PENDING_RESERVATION
  RESERVED
  REUSED
  UNAVAILABLE
}

enum CategoryType {
  MATERIAL
  PROJECT
  BOTH
}

enum OrganizationType {
  WORKSHOP
  FACTORY
  EDUCATIONAL_INSTITUTION
}

enum VerificationDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReservationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum ReservationStatusGroup {
  RESERVATION
  DELIVERY
}

enum PickupType {
  SELF_PICKUP
  DELIVERY_ALLOWED
}

enum DeliveryStatus {
  WAITING_FOR_DRIVER
  DRIVER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  FAILED_PICKUP
}

enum ReviewTargetType {
  SUPPLIER
  DRIVER
  MATERIAL
}

enum MaterialPriceRuleStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
}

enum MaterialPriceRuleSourceType {
  MANUAL
  IMPORTED
  AI_PROPOSED
}

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiLookupStatus {
  SUCCESS
  FAILED
  SKIPPED
  PENDING_REVIEW
}

model User {
  id                           String                     @id @default(cuid())
  displayName                  String                     @map("display_name")
  email                        String                     @unique
  phone                        String?                    @unique
  passwordHash                 String                     @map("password_hash")
  accountStatus                AccountStatus              @default(PENDING_VERIFICATION) @map("account_status")
  profileImageUrl              String?                    @map("profile_image_url")
  emailVerifiedAt              DateTime?                  @map("email_verified_at")
  phoneVerifiedAt              DateTime?                  @map("phone_verified_at")
  lastLoginAt                  DateTime?                  @map("last_login_at")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  roles                        UserRoleAssignment[]
  authTokens                   AuthToken[]
  learnerProfile               LearnerProfile?
  supplierProfile              SupplierProfile?
  invitedRoles                 RoleInvitation[]           @relation("RoleInvitationInvitedBy")
  usedInvitations              RoleInvitation[]           @relation("RoleInvitationUsedByUser")
  assignedRoles                UserRoleAssignment[]       @relation("UserRoleAssignedBy")
  ownedMaterials               Material[]                 @relation("MaterialOwner")
  ownedReservationsAsOwner     Reservation[]              @relation("ReservationOwner")
  ownedReservationsAsRequester Reservation[]              @relation("ReservationRequester")
  reservationStatusChanges     ReservationStatusHistory[] @relation("ReservationStatusChangedBy")
  notifications                Notification[]
  reviewsGiven                 Review[]                   @relation("ReviewReviewer")
  reviewsReceived              Review[]                   @relation("ReviewReviewedUser")
  priceRuleRequests            PriceRuleRequest[]
  categoryRequests             CategoryRequest[]

  @@map("users")
}

model UserRoleAssignment {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  role           UserRole
  isPrimary      Boolean  @default(false) @map("is_primary")
  assignedBy     String?  @map("assigned_by")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([userId])
  @@index([assignedBy])
  @@map("user_roles")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  tokenHash String        @unique @map("token_hash")
  tokenType AuthTokenType @map("token_type")
  target    String
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model RoleInvitation {
  id            String                   @id @default(cuid())
  targetEmail   String?                  @map("target_email")
  targetPhone   String?                  @map("target_phone")
  targetRole    RoleInvitationTargetRole @map("target_role")
  tokenHash     String                   @unique @map("token_hash")
  invitedBy     String?                  @map("invited_by")
  status        RoleInvitationStatus     @default(PENDING)
  expiresAt     DateTime                 @map("expires_at")
  usedAt        DateTime?                @map("used_at")
  usedByUserId  String?                  @map("used_by_user_id")
  notes         String?
  createdAt     DateTime                 @default(now()) @map("created_at")
  invitedByUser User?                    @relation("RoleInvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  usedByUser    User?                    @relation("RoleInvitationUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([targetEmail])
  @@index([targetPhone])
  @@index([targetRole, status])
  @@index([expiresAt])
  @@map("role_invitations")
}

model LearnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  learnerType String?  @map("learner_type")
  bio         String?
  interests   String[] @default([])
  skillLevel  String?  @map("skill_level")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

model SupplierProfile {
  id                      String               @id @default(cuid())
  userId                  String               @unique @map("user_id")
  supplierType            String?              @map("supplier_type")
  publicName              String?              @map("public_name")
  description             String?
  verificationStatus      String               @default("UNVERIFIED") @map("verification_status")
  defaultPickupLocationId String?              @map("default_pickup_location_id")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPickupLocation   Location?            @relation("SupplierDefaultPickupLocation", fields: [defaultPickupLocationId], references: [id], onDelete: SetNull)
  organizationProfile     OrganizationProfile?
  materials               Material[]

  @@index([defaultPickupLocationId])
  @@map("supplier_profiles")
}

model OrganizationProfile {
  id                         String                      @id @default(cuid())
  supplierProfileId          String                      @unique @map("supplier_profile_id")
  organizationName           String                      @map("organization_name")
  organizationType           OrganizationType            @map("organization_type")
  contactPersonName          String?                     @map("contact_person_name")
  workingDays                Json?                       @map("working_days")
  workingHours               Json?                       @map("working_hours")
  businessLocationId         String?                     @map("business_location_id")
  verificationDocumentStatus VerificationDocumentStatus? @map("verification_document_status")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  supplierProfile            SupplierProfile             @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  businessLocation           Location?                   @relation("OrganizationBusinessLocation", fields: [businessLocationId], references: [id], onDelete: SetNull)

  @@index([businessLocationId])
  @@map("organization_profiles")
}

model Location {
  id                      String                                @id @default(cuid())
  country                 String
  city                    String
  area                    String?
  addressLine             String?                               @map("address_line")
  latitude                Decimal?                              @db.Decimal(9, 6)
  longitude               Decimal?                              @db.Decimal(9, 6)
  location                Unsupported("geography(Point,4326)")?
  locationType            String?                               @map("location_type")
  visibility              String?                               @default("PRIVATE")
  isApproximate           Boolean                               @default(true) @map("is_approximate")
  createdAt               DateTime                              @default(now()) @map("created_at")
  updatedAt               DateTime                              @updatedAt @map("updated_at")
  supplierPickupFor       SupplierProfile[]                     @relation("SupplierDefaultPickupLocation")
  organizationBusinessFor OrganizationProfile[]                 @relation("OrganizationBusinessLocation")
  materials               Material[]
  reservationDropoffs     Reservation[]                         @relation("ReservationDropoffLocation")

  @@index([country, city])
  @@map("locations")
}

model Category {
  id                       String             @id @default(cuid())
  nameEn                   String             @map("name_en")
  nameAr                   String             @map("name_ar")
  parentId                 String?            @map("parent_id")
  categoryType             CategoryType       @map("category_type")
  iconUrl                  String?            @map("icon_url")
  createdAt                DateTime           @default(now()) @map("created_at")
  parent                   Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                 Category[]         @relation("CategoryHierarchy")
  materials                Material[]
  materialTypes            MaterialType[]
  approvedCategoryRequests CategoryRequest[]  @relation("ApprovedCategoryRequests")
  priceRuleRequests        PriceRuleRequest[]

  @@index([parentId])
  @@map("categories")
}

model Material {
  id                            String             @id @default(cuid())
  ownerId                       String             @map("owner_id")
  supplierProfileId             String?            @map("supplier_profile_id")
  categoryId                    String             @map("category_id")
  title                         String
  description                   String
  materialType                  String             @map("material_type")
  materialTypeId                String?            @map("material_type_id")
  customMaterialType            String?            @map("custom_material_type")
  priceRuleId                   String?            @map("price_rule_id")
  priceCheckedAt                DateTime?          @map("price_checked_at")
  maxAllowedPriceAtCheck        Decimal?           @map("max_allowed_price_at_check") @db.Decimal(12, 2)
  quantity                      Decimal            @db.Decimal(12, 3)
  unit                          String
  condition                     MaterialCondition
  sourceType                    MaterialSourceType @map("source_type")
  status                        MaterialStatus     @default(AVAILABLE)
  isFree                        Boolean            @default(true) @map("is_free")
  price                         Decimal?           @db.Decimal(12, 2)
  currency                      String             @default("NIS")
  locationId                    String             @map("location_id")
  pickupAllowed                 Boolean            @default(true) @map("pickup_allowed")
  deliveryAllowed               Boolean            @default(false) @map("delivery_allowed")
  pickupNotes                   String?            @map("pickup_notes")
  suggestedUses                 String?            @map("suggested_uses")
  viewsCount                    Int                @default(0) @map("views_count")
  reusedAt                      DateTime?          @map("reused_at")
  reusedByReservationId         String?            @unique @map("reused_by_reservation_id")
  createdAt                     DateTime           @default(now()) @map("created_at")
  updatedAt                     DateTime           @updatedAt @map("updated_at")
  owner                         User               @relation("MaterialOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  supplierProfile               SupplierProfile?   @relation(fields: [supplierProfileId], references: [id], onDelete: SetNull)
  category                      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedMaterialType          MaterialType?      @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  priceRule                     MaterialPriceRule? @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)
  location                      Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  images                        MaterialImage[]
  reservations                  Reservation[]
  reusedByReservation           Reservation?       @relation("MaterialReusedByReservation", fields: [reusedByReservationId], references: [id], onDelete: SetNull)
  publishedFromCategoryRequest  CategoryRequest?   @relation("CategoryRequestPublishedMaterial")
  publishedFromPriceRuleRequest PriceRuleRequest?  @relation("PriceRuleRequestPublishedMaterial")

  @@index([ownerId])
  @@index([supplierProfileId])
  @@index([categoryId])
  @@index([materialTypeId])
  @@index([priceRuleId])
  @@index([status])
  @@index([locationId])
  @@map("materials")
}

model MaterialImage {
  id         String   @id @default(cuid())
  materialId String   @map("material_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  isCover    Boolean  @default(false) @map("is_cover")
  createdAt  DateTime @default(now()) @map("created_at")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_images")
}

model Reservation {
  id                String                     @id @default(cuid())
  materialId        String                     @map("material_id")
  requesterId       String                     @map("requester_id")
  ownerId           String                     @map("owner_id")
  quantityRequested Decimal                    @map("quantity_requested") @db.Decimal(12, 3)
  message           String?
  status            ReservationStatus          @default(PENDING)
  pickupWindowStart DateTime?                  @map("pickup_window_start")
  pickupWindowEnd   DateTime?                  @map("pickup_window_end")
  pickupType        PickupType                 @default(SELF_PICKUP) @map("pickup_type")
  supplierNote      String?                    @map("supplier_note")
  rejectionReason   String?                    @map("rejection_reason")
  acceptedAt        DateTime?                  @map("accepted_at")
  rejectedAt        DateTime?                  @map("rejected_at")
  cancelledAt       DateTime?                  @map("cancelled_at")
  deliveryRequested Boolean                    @default(false) @map("delivery_requested")
  deliveryStatus    DeliveryStatus?            @map("delivery_status")
  deliveryCost      Decimal?                   @map("delivery_cost") @db.Decimal(12, 2)
  dropoffLocationId String?                    @map("dropoff_location_id")
  driverProfileId   String?                    @map("driver_profile_id")
  completedAt       DateTime?                  @map("completed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  material          Material                   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requester         User                       @relation("ReservationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner             User                       @relation("ReservationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dropoffLocation   Location?                  @relation("ReservationDropoffLocation", fields: [dropoffLocationId], references: [id], onDelete: SetNull)
  reusedMaterial    Material?                  @relation("MaterialReusedByReservation")
  reviews           Review[]
  statusHistory     ReservationStatusHistory[]

  @@index([ownerId])
  @@index([requesterId])
  @@index([materialId])
  @@index([status])
  @@map("reservations")
}

model ReservationStatusHistory {
  id            String                 @id @default(cuid())
  reservationId String                 @map("reservation_id")
  statusGroup   ReservationStatusGroup @default(RESERVATION) @map("status_group")
  oldStatus     String?                @map("old_status")
  newStatus     String                 @map("new_status")
  changedBy     String?                @map("changed_by")
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at")
  reservation   Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  changedByUser User?                  @relation("ReservationStatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([statusGroup])
  @@index([changedBy])
  @@map("reservation_status_history")
}

model Review {
  id             String           @id @default(cuid())
  reservationId  String           @map("reservation_id")
  reviewerId     String           @map("reviewer_id")
  reviewedUserId String?          @map("reviewed_user_id")
  targetType     ReviewTargetType @map("target_type")
  rating         Int
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at")
  reservation    Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reviewer       User             @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User?            @relation("ReviewReviewedUser", fields: [reviewedUserId], references: [id], onDelete: SetNull)

  @@index([reviewedUserId, targetType])
  @@index([reservationId])
  @@map("reviews")
}

model Notification {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  notificationType  String   @map("notification_type")
  title             String
  body              String
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id")
  isRead            Boolean  @default(false) @map("is_read")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model MaterialType {
  id                String              @id @default(cuid())
  categoryId        String              @map("category_id")
  nameEn            String              @map("name_en")
  nameAr            String?             @map("name_ar")
  normalizedName    String              @map("normalized_name")
  defaultUnit       String              @default("piece") @map("default_unit")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aliases           MaterialTypeAlias[]
  priceRules        MaterialPriceRule[]
  materials         Material[]
  priceRuleRequests PriceRuleRequest[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId])
  @@index([nameEn])
  @@index([isActive])
  @@map("material_types")
}

model MaterialTypeAlias {
  id              String       @id @default(cuid())
  materialTypeId  String       @map("material_type_id")
  alias           String
  normalizedAlias String       @map("normalized_alias")
  language        String?
  createdAt       DateTime     @default(now()) @map("created_at")
  materialType    MaterialType @relation(fields: [materialTypeId], references: [id], onDelete: Cascade)

  @@unique([materialTypeId, normalizedAlias])
  @@index([materialTypeId])
  @@index([normalizedAlias])
  @@map("material_type_aliases")
}

model MaterialPriceRule {
  id                      String                      @id @default(cuid())
  materialTypeId          String                      @map("material_type_id")
  currency                String                      @default("NIS")
  unit                    String
  maxAllowedUnitPriceNis  Decimal?                    @map("max_allowed_unit_price_nis") @db.Decimal(10, 2)
  maxAllowedTotalPriceNis Decimal?                    @map("max_allowed_total_price_nis") @db.Decimal(10, 2)
  conditionFactorsJson    Json?                       @map("condition_factors_json")
  sourceType              MaterialPriceRuleSourceType @default(MANUAL) @map("source_type")
  status                  MaterialPriceRuleStatus     @default(PENDING_REVIEW)
  sourceNote              String?                     @map("source_note")
  confidence              Decimal?                    @db.Decimal(5, 2)
  isActive                Boolean                     @default(true) @map("is_active")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  materialType            MaterialType                @relation(fields: [materialTypeId], references: [id], onDelete: Cascade)
  materials               Material[]

  @@index([materialTypeId])
  @@index([status])
  @@index([isActive])
  @@index([currency])
  @@index([unit])
  @@map("material_price_rules")
}

model PriceRuleRequest {
  id                          String                @id @default(cuid())
  materialTypeId              String?               @map("material_type_id")
  materialName                String?               @map("material_name")
  normalizedMaterialName      String?               @map("normalized_material_name")
  categoryId                  String?               @map("category_id")
  unit                        String?
  condition                   MaterialCondition?
  quantity                    Decimal?              @db.Decimal(10, 2)
  supplierPriceNis            Decimal?              @map("supplier_price_nis") @db.Decimal(10, 2)
  requestedByUserId           String?               @map("requested_by_user_id")
  status                      MaterialRequestStatus @default(PENDING)
  aiSuggestedUnit             String?               @map("ai_suggested_unit")
  aiSuggestedMaxUnitPriceNis  Decimal?              @map("ai_suggested_max_unit_price_nis") @db.Decimal(10, 2)
  aiSuggestedMaxTotalPriceNis Decimal?              @map("ai_suggested_max_total_price_nis") @db.Decimal(10, 2)
  aiSuggestedAliasesJson      Json?                 @map("ai_suggested_aliases_json")
  aiResultJson                Json?                 @map("ai_result_json")
  moderatorNote               String?               @map("moderator_note")
  listingDraftJson            Json?                 @map("listing_draft_json")
  publishedMaterialId         String?               @unique @map("published_material_id")
  publishedAt                 DateTime?             @map("published_at")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  materialType                MaterialType?         @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  category                    Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requestedBy                 User?                 @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  publishedMaterial           Material?             @relation("PriceRuleRequestPublishedMaterial", fields: [publishedMaterialId], references: [id], onDelete: SetNull)

  @@index([materialTypeId])
  @@index([categoryId])
  @@index([normalizedMaterialName])
  @@index([requestedByUserId])
  @@index([status])
  @@map("price_rule_requests")
}

model CategoryRequest {
  id                      String                @id @default(cuid())
  requestedName           String                @map("requested_name")
  normalizedRequestedName String                @map("normalized_requested_name")
  requestedByUserId       String                @map("requested_by_user_id")
  status                  MaterialRequestStatus @default(PENDING)
  approvedCategoryId      String?               @map("approved_category_id")
  moderatorNote           String?               @map("moderator_note")
  listingDraftJson        Json?                 @map("listing_draft_json")
  publishedMaterialId     String?               @unique @map("published_material_id")
  publishedAt             DateTime?             @map("published_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  requestedBy             User                  @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedCategory        Category?             @relation("ApprovedCategoryRequests", fields: [approvedCategoryId], references: [id], onDelete: SetNull)
  publishedMaterial       Material?             @relation("CategoryRequestPublishedMaterial", fields: [publishedMaterialId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId])
  @@index([status])
  @@index([normalizedRequestedName])
  @@map("category_requests")
}

model AiPriceLookupLog {
  id              String         @id @default(cuid())
  query           String
  normalizedQuery String         @map("normalized_query")
  resultJson      Json?          @map("result_json")
  status          AiLookupStatus
  costEstimate    Decimal?       @map("cost_estimate") @db.Decimal(10, 4)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([normalizedQuery])
  @@index([status])
  @@map("ai_price_lookup_logs")
}

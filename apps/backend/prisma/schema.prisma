  deliveryFee                       Decimal?                     @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount                       Decimal?                     @map("total_amount") @db.Decimal(12, 2)
  pricingCurrency                   String?                      @default("NIS") @map("pricing_currency")
  deliveryZone                      DeliveryZone?                @map("delivery_zone")
  dropoffCity                       String?                      @map("dropoff_city")
  dropoffArea                       String?                      @map("dropoff_area")

  supplierPickupWindowEnd           DateTime?                    @map("supplier_pickup_window_end")
  confirmedDeliveryWindowStart      DateTime?                    @map("confirmed_delivery_window_start")
  confirmedDeliveryWindowEnd        DateTime?                    @map("confirmed_delivery_window_end")
  earliestDeliveryStart             DateTime?                    @map("earliest_delivery_start")

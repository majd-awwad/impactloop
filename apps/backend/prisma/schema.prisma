generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  SUPPLIER
  DRIVER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PHONE_OTP
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum RoleInvitationTargetRole {
  DRIVER
  MODERATOR
  ADMIN
}

enum RoleInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleInvitationSendStatus {
  PENDING
  SENT
  FAILED
}

enum TransportationType {
  CAR
  MOTORCYCLE
  BICYCLE
  WALKING
}

enum MaterialCondition {
  NEW
  LIKE_NEW
  GOOD
  USED
  NEEDS_REPAIR
}

enum MaterialSourceType {
  STUDENT_LEFTOVER
  WORKSHOP_SURPLUS
  FACTORY_SURPLUS
  EDUCATIONAL_INSTITUTION
}

enum MaterialStatus {
  AVAILABLE
  PENDING_RESERVATION
  RESERVED
  REUSED
  UNAVAILABLE
}

enum MaterialReportReason {
  MISLEADING_INFORMATION
  WRONG_CATEGORY
  WRONG_PRICE
  INAPPROPRIATE
  ITEM_NOT_AVAILABLE
  SUSPICIOUS_SUPPLIER
  OTHER
}

enum MaterialReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum CategoryType {
  MATERIAL
  PROJECT
  BOTH
}

enum OrganizationType {
  WORKSHOP
  FACTORY
  EDUCATIONAL_INSTITUTION
}

enum VerificationDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  CHANGES_REQUESTED
}

enum ReservationStatus {
  PENDING
  AWAITING_LEARNER_CONFIRMATION
  AWAITING_SUPPLIER_CONFIRMATION
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
  NO_SHOW
  FULFILLMENT_FAILED
  AWAITING_RESOLUTION
}

enum RescheduleRequestedBy {
  SUPPLIER
  LEARNER
}

enum NoShowReportReason {
  LEARNER_DID_NOT_ARRIVE
  DRIVER_DID_NOT_ARRIVE
  NO_RESPONSE_AFTER_PICKUP_WINDOW
  REPEATED_DELAY
  WRONG_INFORMATION
  SAFETY_OR_TRUST_CONCERN
  SUPPLIER_UNAVAILABLE
  SUPPLIER_MATERIAL_NOT_READY
  NO_DRIVER_AVAILABLE
  PICKUP_FAILED
  DELIVERY_FAILED
  DRIVER_ISSUE
  OTHER
}

enum NoShowReportStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  RESOLVED_NO_STRIKE
}

enum NoShowReportTargetRole {
  LEARNER
  SUPPLIER
  DRIVER
  SYSTEM
}

enum ReservationStatusGroup {
  RESERVATION
  DELIVERY
}

enum ReservationFulfillmentMethod {
  PICKUP
  DELIVERY
}

enum DeliveryZone {
  SAME_CITY
  WEST_BANK
  JERUSALEM
  INSIDE_48
  UNKNOWN
}

enum DeliveryGroupStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  WAITING_FOR_DRIVER
  DRIVER_ASSIGNED
  ARRIVED_PICKUP
  PICKED_UP
  ON_THE_WAY
  ARRIVED_DROPOFF
  DELIVERED
  CANCELLED
  FAILED_PICKUP
  FAILED_DELIVERY
  DRIVER_NO_SHOW
  LEARNER_NO_SHOW
  AWAITING_RESOLUTION
}

enum DriverProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DriverAvailabilityStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

enum DeliveryAssignmentStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum ReviewTargetType {
  SUPPLIER
  DRIVER
  MATERIAL
}

enum MaterialPriceRuleStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
}

enum MaterialPriceRuleSourceType {
  MANUAL
  IMPORTED
  AI_PROPOSED
}

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiLookupStatus {
  SUCCESS
  FAILED
  SKIPPED
  PENDING_REVIEW
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearningProjectStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum ProjectComponentRole {
  REQUIRED_MATERIAL
  OPTIONAL_MATERIAL
  TOOL
  CONSUMABLE
  ALTERNATIVE
}

enum ProjectReviewStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

enum ProjectLinkType {
  YOUTUBE
  GITHUB
  ARTICLE
  PDF
  OTHER
}

enum ProjectBuildStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectBuildItemStatus {
  MISSING
  ALREADY_OWNED
  AVAILABLE
  RESERVED
  ALTERNATIVE
}

model User {
  id                            String                     @id @default(cuid())
  displayName                   String                     @map("display_name")
  email                         String                     @unique
  phone                         String?                    @unique
  passwordHash                  String                     @map("password_hash")
  accountStatus                 AccountStatus              @default(PENDING_VERIFICATION) @map("account_status")
  profileImageUrl               String?                    @map("profile_image_url")
  emailVerifiedAt               DateTime?                  @map("email_verified_at")
  phoneVerifiedAt               DateTime?                  @map("phone_verified_at")
  lastLoginAt                   DateTime?                  @map("last_login_at")
  activeRole                    UserRole?                  @map("active_role")
  suspensionReason              String?                    @map("suspension_reason")
  suspendedAt                   DateTime?                  @map("suspended_at")
  suspendedById                 String?                    @map("suspended_by_id")
  reactivatedAt                 DateTime?                  @map("reactivated_at")
  reactivatedById               String?                    @map("reactivated_by_id")
  createdAt                     DateTime                   @default(now()) @map("created_at")
  updatedAt                     DateTime                   @updatedAt @map("updated_at")
  roles                         UserRoleAssignment[]
  authTokens                    AuthToken[]
  learnerProfile                LearnerProfile?
  supplierProfile               SupplierProfile?
  driverProfile                 DriverProfile?
  invitedRoles                  RoleInvitation[]           @relation("RoleInvitationInvitedBy")
  usedInvitations               RoleInvitation[]           @relation("RoleInvitationUsedByUser")
  assignedRoles                 UserRoleAssignment[]       @relation("UserRoleAssignedBy")
  ownedMaterials                Material[]                 @relation("MaterialOwner")
  ownedReservationsAsOwner      Reservation[]              @relation("ReservationOwner")
  ownedReservationsAsRequester  Reservation[]              @relation("ReservationRequester")
  deliveryGroupsAsLearner       DeliveryGroup[]            @relation("DeliveryGroupLearner")
  reservationStatusChanges      ReservationStatusHistory[] @relation("ReservationStatusChangedBy")
  requestedDeliveries           Delivery[]                 @relation("DeliveryRequestedBy")
  deliveryAssignmentsMade       DeliveryAssignment[]       @relation("DeliveryAssignedBy")
  deliveryStatusChanges         DeliveryStatusHistory[]    @relation("DeliveryStatusChangedBy")
  idempotencyRecords            IdempotencyRecord[]
  notifications                 Notification[]
  reviewsGiven                  Review[]                   @relation("ReviewReviewer")
  reviewsReceived               Review[]                   @relation("ReviewReviewedUser")
  createdLearningProjects       LearningProject[]          @relation("LearningProjectCreatedBy")
  reviewedLearningProjects      LearningProject[]          @relation("LearningProjectReviewedBy")
  supplierVerificationsReviewed SupplierProfile[]          @relation("SupplierVerificationReviewedBy")
  approvedProjectSteps          ProjectStep[]              @relation("ProjectStepApprovedBy")
  priceRuleRequests             PriceRuleRequest[]
  categoryRequests              CategoryRequest[]
  materialReportsSubmitted      MaterialReport[]           @relation("MaterialReportReporter")
  materialReportsReviewed       MaterialReport[]           @relation("MaterialReportReviewedBy")
  reservationMessagesSent       ReservationMessage[]       @relation("ReservationMessageSender")
  noShowReportsSubmitted        NoShowReport[]             @relation("NoShowReportReporter")
  noShowReportsTargeted         NoShowReport[]             @relation("NoShowReportTarget")
  noShowReportsReviewed         NoShowReport[]             @relation("NoShowReportReviewedBy")
  moderatedMaterials            Material[]                 @relation("MaterialModeratedBy")
  supplierFollows               SupplierFollower[]         @relation("SupplierFollowerUser")
  materialLikes                 MaterialLike[]             @relation("MaterialLikeUser")
  materialViews                 MaterialView[]             @relation("MaterialViewUser")
  projectLikes                  ProjectLike[]              @relation("ProjectLikeUser")
  projectSaves                  ProjectSave[]              @relation("ProjectSaveUser")
  projectFollows                ProjectFollow[]            @relation("ProjectFollowUser")
  projectReviews                ProjectUserReview[]        @relation("ProjectUserReviewUser")
  projectBuilds                 ProjectBuild[]             @relation("ProjectBuildLearner")
  savedLocations                UserSavedLocation[]
  suspendedBy                   User?                      @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  accountsSuspended             User[]                     @relation("UserSuspendedBy")
  reactivatedBy                 User?                      @relation("UserReactivatedBy", fields: [reactivatedById], references: [id], onDelete: SetNull)
  accountsReactivated           User[]                     @relation("UserReactivatedBy")
  adminActivityLogs             AdminActivityLog[]

  @@index([suspendedById])
  @@index([reactivatedById])
  @@map("users")
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String   @map("target_label")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("admin_activity_logs")
}

model UserRoleAssignment {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  role           UserRole
  isPrimary      Boolean  @default(false) @map("is_primary")
  assignedBy     String?  @map("assigned_by")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([userId])
  @@index([assignedBy])
  @@map("user_roles")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  tokenHash String        @unique @map("token_hash")
  tokenType AuthTokenType @map("token_type")
  target    String
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model RoleInvitation {
  id                String                   @id @default(cuid())
  targetEmail       String?                  @map("target_email")
  targetPhone       String?                  @map("target_phone")
  targetRole        RoleInvitationTargetRole @map("target_role")
  tokenHash         String                   @unique @map("token_hash")
  invitedBy         String?                  @map("invited_by")
  status            RoleInvitationStatus     @default(PENDING)
  sendStatus        RoleInvitationSendStatus @default(PENDING) @map("send_status")
  sentAt            DateTime?                @map("sent_at")
  sendError         String?                  @map("send_error")
  providerMessageId String?                  @map("provider_message_id")
  revokedAt         DateTime?                @map("revoked_at")
  expiresAt         DateTime                 @map("expires_at")
  usedAt            DateTime?                @map("used_at")
  usedByUserId      String?                  @map("used_by_user_id")
  notes             String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  invitedByUser     User?                    @relation("RoleInvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  usedByUser        User?                    @relation("RoleInvitationUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([targetEmail])
  @@index([targetPhone])
  @@index([targetRole, status])
  @@index([expiresAt])
  @@index([sendStatus])
  @@map("role_invitations")
}

model LearnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  learnerType String?  @map("learner_type")
  bio         String?
  interests   String[] @default([])
  skillLevel  String?  @map("skill_level")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
}

model SupplierProfile {
  id                       String               @id @default(cuid())
  userId                   String               @unique @map("user_id")
  supplierType             String?              @map("supplier_type")
  publicName               String?              @map("public_name")
  description              String?
  coverImageUrl            String?              @map("cover_image_url")
  avatarImageUrl           String?              @map("avatar_image_url")
  verificationStatus       String               @default("UNVERIFIED") @map("verification_status")
  verificationSubmittedAt  DateTime?            @map("verification_submitted_at")
  verificationReviewedAt   DateTime?            @map("verification_reviewed_at")
  verificationReviewedById String?              @map("verification_reviewed_by_id")
  verificationAdminNote    String?              @map("verification_admin_note")
  defaultPickupLocationId  String?              @map("default_pickup_location_id")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationReviewedBy   User?                @relation("SupplierVerificationReviewedBy", fields: [verificationReviewedById], references: [id], onDelete: SetNull)
  defaultPickupLocation    Location?            @relation("SupplierDefaultPickupLocation", fields: [defaultPickupLocationId], references: [id], onDelete: SetNull)
  organizationProfile      OrganizationProfile?
  materials                Material[]
  followers                SupplierFollower[]
  deliveryGroups           DeliveryGroup[]

  @@index([defaultPickupLocationId])
  @@index([verificationReviewedById])
  @@map("supplier_profiles")
}

model SupplierFollower {
  id                String          @id @default(cuid())
  supplierProfileId String          @map("supplier_profile_id")
  followerUserId    String          @map("follower_user_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  followerUser      User            @relation("SupplierFollowerUser", fields: [followerUserId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, followerUserId])
  @@index([supplierProfileId])
  @@index([followerUserId])
  @@map("supplier_followers")
}

model DriverProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique @map("user_id")
  displayName        String                   @map("display_name")
  phone              String
  city               String
  area               String
  addressLine        String?                  @map("address_line")
  transportationType TransportationType       @map("transportation_type")
  availabilityNote   String?                  @map("availability_note")
  status             DriverProfileStatus      @default(ACTIVE)
  availability       DriverAvailabilityStatus @default(OFFLINE)
  vehicleType        String                   @default("UNSPECIFIED") @map("vehicle_type")
  vehicleLabel       String?                  @map("vehicle_label")
  vehiclePlate       String?                  @map("vehicle_plate")
  capacityNotes      String?                  @map("capacity_notes")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries         Delivery[]               @relation("AssignedDriverDeliveries")
  assignedDeliveryGroups DeliveryGroup[]      @relation("AssignedDriverDeliveryGroups")
  assignments        DeliveryAssignment[]
  locationPings      DeliveryLocationPing[]

  @@index([status, availability])
  @@map("driver_profiles")
}

model OrganizationProfile {
  id                         String                      @id @default(cuid())
  supplierProfileId          String                      @unique @map("supplier_profile_id")
  organizationName           String                      @map("organization_name")
  organizationType           OrganizationType            @map("organization_type")
  contactPersonName          String?                     @map("contact_person_name")
  workingDays                Json?                       @map("working_days")
  workingHours               Json?                       @map("working_hours")
  businessLocationId         String?                     @map("business_location_id")
  verificationDocumentStatus VerificationDocumentStatus? @map("verification_document_status")
  verificationDocumentUrl    String?                     @map("verification_document_url")
  verificationDocumentName   String?                     @map("verification_document_name")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  supplierProfile            SupplierProfile             @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  businessLocation           Location?                   @relation("OrganizationBusinessLocation", fields: [businessLocationId], references: [id], onDelete: SetNull)

  @@index([businessLocationId])
  @@map("organization_profiles")
}

model Location {
  id                      String                                @id @default(cuid())
  country                 String
  city                    String
  area                    String?
  addressLine             String?                               @map("address_line")
  latitude                Decimal?                              @db.Decimal(9, 6)
  longitude               Decimal?                              @db.Decimal(9, 6)
  location                Unsupported("geography(Point,4326)")?
  locationType            String?                               @map("location_type")
  visibility              String?                               @default("PRIVATE")
  isApproximate           Boolean                               @default(true) @map("is_approximate")
  createdAt               DateTime                              @default(now()) @map("created_at")
  updatedAt               DateTime                              @updatedAt @map("updated_at")
  supplierPickupFor       SupplierProfile[]                     @relation("SupplierDefaultPickupLocation")
  organizationBusinessFor OrganizationProfile[]                 @relation("OrganizationBusinessLocation")
  materials               Material[]
  deliveryPickups         Delivery[]                            @relation("DeliveryPickupLocation")
  deliveryDropoffs        Delivery[]                            @relation("DeliveryDropoffLocation")
  savedByUsers            UserSavedLocation[]

  @@index([country, city])
  @@map("locations")
}

model UserSavedLocation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  label      String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([locationId])
  @@map("user_saved_locations")
}

model Category {
  id                        String                     @id @default(cuid())
  nameEn                    String                     @map("name_en")
  nameAr                    String                     @map("name_ar")
  parentId                  String?                    @map("parent_id")
  categoryType              CategoryType               @map("category_type")
  iconUrl                   String?                    @map("icon_url")
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  parent                    Category?                  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                  Category[]                 @relation("CategoryHierarchy")
  materials                 Material[]
  learningProjects          LearningProject[]
  projectRequiredComponents ProjectRequiredComponent[]
  materialTypes             MaterialType[]
  approvedCategoryRequests  CategoryRequest[]          @relation("ApprovedCategoryRequests")
  priceRuleRequests         PriceRuleRequest[]

  @@index([parentId])
  @@index([categoryType, isActive])
  @@map("categories")
}

model LearningProject {
  id                       String                     @id @default(uuid())
  categoryId               String                     @map("category_id")
  createdBy                String                     @map("created_by")
  title                    String
  shortDescription         String                     @map("short_description")
  description              String
  difficulty               ProjectDifficulty
  estimatedDurationMinutes Int?                       @map("estimated_duration_minutes")
  coverImageUrl            String?                    @map("cover_image_url")
  status                   LearningProjectStatus      @default(DRAFT)
  submittedAt              DateTime?                  @map("submitted_at")
  reviewedBy               String?                    @map("reviewed_by")
  reviewedAt               DateTime?                  @map("reviewed_at")
  reviewNote               String?                    @map("review_note")
  rejectionReason          String?                    @map("rejection_reason")
  changesRequestedReason   String?                    @map("changes_requested_reason")
  hiddenAt                 DateTime?                  @map("hidden_at")
  hiddenBy                 String?                    @map("hidden_by")
  hiddenReason             String?                    @map("hidden_reason")
  archivedAt               DateTime?                  @map("archived_at")
  archivedBy               String?                    @map("archived_by")
  archivedReason           String?                    @map("archived_reason")
  stepsGeneratedByAi       Boolean                    @default(false) @map("steps_generated_by_ai")
  aiStepsGeneratedAt       DateTime?                  @map("ai_steps_generated_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  category                 Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser            User                       @relation("LearningProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewedByUser           User?                      @relation("LearningProjectReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  images                   ProjectImage[]
  requiredComponents       ProjectRequiredComponent[]
  steps                    ProjectStep[]
  links                    ProjectLink[]
  tags                     ProjectTag[]
  likes                    ProjectLike[]
  saves                    ProjectSave[]
  follows                  ProjectFollow[]
  userReviews              ProjectUserReview[]
  builds                   ProjectBuild[]

  @@index([categoryId])
  @@index([createdBy])
  @@index([reviewedBy])
  @@index([status, createdAt])
  @@map("learning_projects")
}

model ProjectImage {
  id        String          @id @default(uuid())
  projectId String          @map("project_id")
  imageUrl  String          @map("image_url")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  project   LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model ProjectRequiredComponent {
  id                       String               @id @default(uuid())
  projectId                String               @map("project_id")
  categoryId               String?              @map("category_id")
  componentName            String               @map("component_name")
  materialType             String               @map("material_type")
  quantity                 Decimal              @db.Decimal(12, 3)
  unit                     String
  componentRole            ProjectComponentRole @map("component_role")
  isRequired               Boolean              @default(true) @map("is_required")
  canBeSubstituted         Boolean              @default(false) @map("can_be_substituted")
  searchKeywords           Json?                @map("search_keywords")
  alternativeKeywords      Json?                @map("alternative_keywords")
  providedByUser           Boolean              @default(false) @map("provided_by_user")
  confirmedByUser          Boolean              @default(false) @map("confirmed_by_user")
  generatedOrSuggestedByAi Boolean              @default(false) @map("generated_or_suggested_by_ai")
  reviewStatus             ProjectReviewStatus  @default(PENDING_REVIEW) @map("review_status")
  notes                    String?
  createdAt                DateTime             @default(now()) @map("created_at")
  project                  LearningProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category                 Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buildItems               ProjectBuildItem[]

  @@index([projectId])
  @@index([categoryId])
  @@index([reviewStatus])
  @@map("project_required_components")
}

model ProjectStep {
  id             String              @id @default(uuid())
  projectId      String              @map("project_id")
  stepNumber     Int                 @map("step_number")
  title          String
  description    String
  imageUrl       String?             @map("image_url")
  generatedByAi  Boolean             @default(false) @map("generated_by_ai")
  approvedBy     String?             @map("approved_by")
  reviewStatus   ProjectReviewStatus @default(PENDING_REVIEW) @map("review_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  project        LearningProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedByUser User?               @relation("ProjectStepApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, stepNumber])
  @@index([projectId])
  @@index([approvedBy])
  @@index([reviewStatus])
  @@map("project_steps")
}

model ProjectLink {
  id         String          @id @default(uuid())
  projectId  String          @map("project_id")
  linkType   ProjectLinkType @map("link_type")
  url        String
  title      String?
  sourceName String?         @map("source_name")
  createdAt  DateTime        @default(now()) @map("created_at")
  project    LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_links")

+
+    assert.equal(built.ok, false);
+    if (built.ok) {
+      return;
+    }
+    assert.equal(built.code, 'MATERIAL_TAXONOMY_NOT_READY');
+    assert.equal(built.reason, 'CURRENT_MATERIAL_TYPE_MAPPING_TARGET_INVALID');

+      concept('material-form:ghost-unrelated', {
+        id: 'conflict-b',
+        status: 'INACTIVE',
+      }),
+    ];
+
+    const built = buildEvidenceScopedAssignmentRegistry({
+      concepts,
+      finalMaterialType: 'Arduino Uno',
+      categoryFamilyCanonicalKey: 'material-family:electronics',

+export type LikedMaterialsServiceDependencies = {
+  findVisibleLikedMaterials: (
+    userId: string,
+    query: LikedMaterialsQuery,
+  ) => Promise<
+    Awaited<ReturnType<typeof materialsRepository.findVisibleLikedMaterials>>
